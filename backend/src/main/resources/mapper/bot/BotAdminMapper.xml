<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.monitor.platform.bot.BotAdminMapper">

    <resultMap id="BotAdminResultMap" type="com.monitor.platform.bot.BotAdminEntity">
        <id column="id" property="id"/>
        <result column="email" property="email"/>
        <result column="remark" property="remark"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectAll" resultMap="BotAdminResultMap">
        SELECT id, email, remark, created_at
        FROM bot_admins
        ORDER BY created_at, id
    </select>

    <select id="selectByEmail" resultMap="BotAdminResultMap">
        SELECT id, email, remark, created_at
        FROM bot_admins
        WHERE lower(email) = lower(#{email})
    </select>

    <insert id="insertAdmin" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO bot_admins (email, remark, created_at)
        VALUES (#{email}, #{remark}, now())
    </insert>

    <delete id="deleteById">
        DELETE FROM bot_admins WHERE id = #{id}
    </delete>
</mapper>