# ============================================================
# Monitor 容器化部署环境变量示例
# 复制为 .env 后修改；docker compose 会自动读取本文件。
# ============================================================

# ---------- 应用 ----------
TZ=Asia/Shanghai
APP_PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75 -Dfile.encoding=UTF-8

# 容器内监听地址与端口；compose 里已固定为 0.0.0.0:8080，通常无需修改
# SERVER_ADDRESS=0.0.0.0
# SERVER_PORT=8080

# 自定义镜像地址，默认使用 GHCR 上的官方镜像
# MONITOR_IMAGE=ghcr.io/mnwlzf/monitor:latest

# ---------- 数据库（可外挂到已有 PostgreSQL）----------
# 内置 postgres 容器使用下面三个变量初始化数据库
POSTGRES_DB=monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# 应用实际连接串：使用内置容器时指向服务名 postgres；使用外部数据库时改成外部地址
DB_URL=jdbc:postgresql://postgres:5432/monitor
DB_USERNAME=monitor
DB_PASSWORD=change-me-strong-password

# ---------- Redis（可外挂到已有 Redis）----------
# 使用内置容器时指向服务名 redis；使用外部 Redis 时改成外部地址
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=change-me-strong-password

# ---------- 号池秒级采集（直连自建 Sub2API 只读库，可选）----------
# 上游 /admin/usage 只支持按天过滤，无法做分钟级缓存率；直连 Sub2API 的 PostgreSQL
# （读 usage_logs 表）可以按 id 做真增量，把滞后压到 30 秒级，从而支持分钟粒度统计。
# 建议单独建一个只读账号（仅授予 usage_logs 的 SELECT 权限）。
# 不配置时该任务每轮自动跳过，不影响其它采集。
#
# QQ 机器人身份识别还会读 public.users（只取邮箱与角色），需要额外授权：
#   GRANT SELECT ON public.users TO monitor_ro;
SUB2API_DB_ENABLED=false
SUB2API_DB_URL=jdbc:postgresql://your-sub2api-host:5432/sub2api
SUB2API_DB_USERNAME=monitor_ro
SUB2API_DB_PASSWORD=change-me-readonly-password
# 可选调参
# SUB2API_DB_BATCH_SIZE=2000
# SUB2API_DB_MAX_BATCHES=20

# ---------- QQ 机器人（OneBot v11 协议，可选）----------
# 在 NapCat / Lagrange / go-cqhttp 里开启「反向 HTTP 上报」，地址填：
#   http://<本服务地址>:8080/api/v1/bot/onebot
# 并把 Authorization 头配成 Bearer <下面这个密钥>（两边必须一致）。
# 开启后可在群里 @机器人 或私聊发命令（发 /help 看用法）；
# 再配上大模型就能直接自然语言提问，例如「近 7 天哪个号池账号缓存率最低」。
MONITOR_BOT_ENABLED=false
MONITOR_BOT_WEBHOOK_TOKEN=change-me-bot-secret
MONITOR_BOT_API_BASE_URL=http://napcat:3000
MONITOR_BOT_API_TOKEN=
# 逗号分隔的群号 / QQ；留空表示不限制（建议显式配置，否则任何群都能问）
MONITOR_BOT_ALLOWED_GROUPS=
MONITOR_BOT_ALLOWED_USERS=
# 群里是否需要 @机器人 才响应
MONITOR_BOT_REQUIRE_MENTION=true
MONITOR_BOT_COMMAND_PREFIX=/
# 单条回复最大字符数、每个会话保留的历史消息条数（页面上也能改；这里只在首次启动时生效）
# MONITOR_BOT_MAX_REPLY_LENGTH=900
# MONITOR_BOT_MEMORY_WINDOW=10

# 长回复渲染成图片：渠道状态、账户余额这类内容超过上面的最大长度时，
# 会渲染成 PNG 图片发送，避免被截断；渲染失败自动退回截断文本。
# 中文字体（文泉驿微米黑，Apache-2.0）随 JAR 打包，无需在运行环境装字体。
MONITOR_BOT_IMAGE_ENABLED=true
# MONITOR_BOT_IMAGE_WIDTH=760
# 一般不用改：留空用内置字体，填字体名则改用系统字体
# MONITOR_BOT_IMAGE_FONT=Noto Sans CJK SC

# 消息存档：记录「谁说了什么、机器人回了什么、当时是什么身份」，用于事后查证。
# 在「系统设置 → 消息存档」页面可按关键字 / QQ / 时间查询。
MONITOR_BOT_ARCHIVE_ENABLED=true
# 保留天数，超过的每天凌晨自动清理；0 或负数表示永久保留
MONITOR_BOT_ARCHIVE_RETENTION_DAYS=90

# 身份识别：把自建 Sub2API 的平台用户邮箱同步到 Redis，用于区分
# 「平台用户 / 陌生人」与「管理员 / 普通用户」。陌生人只能普通聊天，接触不到任何平台信息。
# 自定义管理员（Sub2API 只允许一个管理员）在页面「系统设置 → 身份识别与管理员」里维护。
MONITOR_BOT_IDENTITY_ENABLED=true
# 允许按 <QQ号>@xx.com 的邮箱自动匹配 QQ，无需手动绑定
MONITOR_BOT_IDENTITY_QQ_MATCH=true

# NapCat 的端口与数据目录直接写在 compose.yaml 的 napcat 服务里（宿主机 5000 / 6099，
# 数据放 /app/napcat），不需要单独的 .env；要改就改那个服务。

# ---------- 天气查询（可选，默认开启）----------
# 用 uapis.cn 的免费天气接口，无需注册与 Key；管理员、平台用户、陌生人都能用。
# 免费额度按次计，默认缓存 10 分钟，避免群里反复问同一个城市把额度打满。
MONITOR_WEATHER_ENABLED=true
# MONITOR_WEATHER_CACHE_TTL=10m
# MONITOR_WEATHER_FORECAST_DAYS=3
# 接口地址与超时（一般不用改）
# MONITOR_WEATHER_BASE_URL=https://uapis.cn
# MONITOR_WEATHER_TIMEOUT=8s

# ---------- 大模型（Spring AI，可选）----------
# 默认 none：不配 Key 也能正常启动，机器人只支持 / 命令；
# 配好 Key 后把 SPRING_AI_MODEL_CHAT 改成 openai 即可开启自然语言问答。
SPRING_AI_MODEL_CHAT=none
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com
SPRING_AI_OPENAI_MODEL=gpt-4o-mini
# SPRING_AI_OPENAI_TEMPERATURE=0.2

# ---------- 凭证加密密钥 ----------
# Base64 编码的 32 字节随机密钥，用于加密上游账号密码，务必自行生成并妥善保存
# 生成示例：openssl rand -base64 32
UPSTREAM_CREDENTIAL_KEY=replace-with-base64-encoded-32-byte-key

# ---------- 登录与权限 ----------
# 管理员账号：可读写全部功能
MONITOR_ADMIN_USERNAME=admin
MONITOR_ADMIN_PASSWORD=change-me-strong-admin-password

# 是否启用登录鉴权（默认 true，本地开发可临时设为 false）
MONITOR_SECURITY_ENABLED=true

# 会话配置
MONITOR_SESSION_TIMEOUT=8h
MONITOR_SESSION_COOKIE_NAME=MONITOR_SESSION
# 使用 HTTPS 时设为 true
MONITOR_SESSION_COOKIE_SECURE=false