POSTGRES_DB=monitor
POSTGRES_USER=monitor_app
POSTGRES_PASSWORD=replace-with-a-strong-local-password
DB_URL=jdbc:postgresql://localhost:5432/monitor
DB_USERNAME=monitor_app
DB_PASSWORD=replace-with-a-strong-local-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=root
REDIS_PASSWORD=replace-with-a-strong-local-password
# Base64 encoding of a random 32-byte AES key used to encrypt upstream credentials.
UPSTREAM_CREDENTIAL_KEY=replace-with-a-base64-32-byte-key
MONITOR_ADMIN_USERNAME=admin
MONITOR_ADMIN_PASSWORD=replace-with-a-strong-admin-password
MONITOR_COLLECTION_ENABLED=true
MONITOR_COLLECTION_FIXED_DELAY_MS=600000
MONITOR_SESSION_COOKIE_SECURE=true
MONITOR_SESSION_TIMEOUT_MINUTES=720
MONITOR_SESSION_COOKIE_NAME=MONITOR_SESSION
MONITOR_COLLECTION_MAX_CONCURRENT_ACCOUNTS=16
MONITOR_COLLECTION_MAX_CONCURRENT_PER_INSTANCE=4
MONITOR_COLLECTION_MAX_RETRIES=1
MONITOR_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
